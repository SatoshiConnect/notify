PORT=3000
NODE_ENV=development
# Create an OAuth Web Client ID in Google Cloud Console and add your HTTPS origin.
GOOGLE_CLIENT_ID=
# Generate with: openssl rand -hex 32
JWT_SECRET=
# DEMO ONLY: guest identities are spoofable and MUST NEVER be used on an internet-facing deployment.
DEV_GUEST_LOGIN=false
# HTTPS reverse proxy required in production. Set true behind trusted HTTPS proxy.
TRUST_PROXY=false
# Optional comma-separated STUN/TURN URLs, e.g. stun:stun.l.google.com:19302,turn:turn.example.com:3478
ICE_URLS=stun:stun.l.google.com:19302
# Turn username and credentials when using turn: URLs
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional background push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional AI chat. Create a key at https://aistudio.google.com/apikey
SATOSHICORE_AI_API_KEY=
SATOSHICORE_AI_MODEL=gemini-3.5-flash-lite

# Comma-separated Google account emails allowed to manage in-app public notices.
ADMIN_EMAILS=

# App credits awarded to each member when a referred user completes first-time wallet setup.
REFERRAL_REWARD_CREDITS=100
